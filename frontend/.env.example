# Frontend environment variables template
# Copy this file to .env and fill in the values appropriate for your deployment.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser at build time.

# ----------------------------------------------------------------------
# Core API endpoint (must be reachable from the browser)
# Example: https://api.finsight.example.com
NEXT_PUBLIC_API_URL=https://api.finsight.example.com

# ----------------------------------------------------------------------
# OpenID Connect (OIDC) configuration for user authentication
# Issuer URL of the identity provider (e.g., Google, Azure AD, Auth0)
NEXT_PUBLIC_OIDC_ISSUER=https://accounts.google.com

# Client ID registered with the OIDC provider
NEXT_PUBLIC_OIDC_CLIENT_ID=your-oidc-client-id

# Redirect URI that the OIDC provider will call after authentication.
# Must be whitelisted in the provider configuration.
NEXT_PUBLIC_OIDC_REDIRECT_URI=https://app.finsight.example.com/auth/callback

# Optional: OIDC scopes (space‑separated). Default includes openid, profile, email.
# NEXT_PUBLIC_OIDC_SCOPES=openid profile email

# ----------------------------------------------------------------------
# Application‑wide feature toggles (optional)

# Enable mock API responses for local development (true/false)
NEXT_PUBLIC_ENABLE_MOCKS=false

# Default tenant slug used when the app is accessed without a tenant context
NEXT_PUBLIC_DEFAULT_TENANT=example-tenant

# ----------------------------------------------------------------------
# Client‑side error monitoring (Sentry, etc.)

# Provide a Sentry DSN to capture frontend errors; leave empty to disable.
NEXT_PUBLIC_SENTRY_DSN=

# ----------------------------------------------------------------------
# Cookie / session settings (used by the auth provider)

# Name of the authentication cookie stored in the browser
NEXT_PUBLIC_COOKIE_NAME=fs_auth_token

# ----------------------------------------------------------------------
# Rate limiting (client‑side advisory; server enforces its own limits)

# Maximum number of API requests per minute the UI will attempt
NEXT_PUBLIC_API_RATE_LIMIT=60

# ----------------------------------------------------------------------
# Additional environment variables can be added here as the project evolves.
# Remember to keep this file out of version‑controlled secrets and never commit
# real credentials. Use a separate .env file in each environment (dev, staging,
# production) with the appropriate values.